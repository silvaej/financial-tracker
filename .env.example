POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_tracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance_tracker

# Login for the seed script's demo@example.com account. Only used by app/seed.py;
# unset means no seed user/data gets created. Never set this in CI -- Actions logs
# are public.
SEED_USER_PASSWORD=staging-demo-password
