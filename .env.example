POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_tracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance_tracker

# Login is Google/GitHub OAuth only -- register an OAuth app with each provider
# (redirect URIs http://localhost:8000/auth/google/callback and
# http://localhost:8000/auth/github/callback for local dev) and set the
# corresponding client id/secret pairs below. Without these, /login and /signup
# render but the provider buttons will fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
